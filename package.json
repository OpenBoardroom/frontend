{
  "name": "openboardroom-frontend",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "check": "biome check . && react-router typegen && tsc -b",
    "dev": "react-router dev",
    "e2e": "react-router build && playwright test",
    "format": "biome check --write .",
    "postinstall": "wrangler types",
    "preview": "react-router build && vite preview",
    "test": "vitest run --coverage",
    "typecheck": "wrangler types && react-router typegen && tsc -b"
  },
  "dependencies": {
    "isbot": "5.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.16.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@cloudflare/vite-plugin": "1.70.1",
    "@playwright/test": "1.65.1",
    "@react-router/dev": "7.16.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "lefthook": "2.2.2",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  }
}
