{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openboardroom-frontend",
  "compatibility_date": "2026-11-22",
  "main": "./workers/app.ts",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  // Worker runs before static assets so redirect hosts 301 every path.
  "assets": { "binding": "ASSETS", "run_worker_first": true },
  "routes": [
    // Every host in architecture spec §5. brdrmr.org and www.brdrmr.org were
    // added at cutover (spec §10), after they were detached from the old Pages project.
    { "pattern": "openboardroom.org", "custom_domain": true },
    { "pattern": "www.openboardroom.org", "custom_domain": true },
    { "pattern": "openboardroom.io", "custom_domain": true },
    { "pattern": "www.openboardroom.io", "custom_domain": true },
    { "pattern": "brdrmr.com", "custom_domain": true },
    { "pattern": "www.brdrmr.com", "custom_domain": true },
    { "pattern": "brdrmr.org", "custom_domain": true },
    { "pattern": "www.brdrmr.org", "custom_domain": true }
  ]
}
