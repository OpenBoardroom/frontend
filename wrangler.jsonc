{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openboardroom-frontend",
  "compatibility_date": "2026-11-22",
  "main": "./workers/app.ts",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare"
  }
}
