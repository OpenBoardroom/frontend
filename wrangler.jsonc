{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openboardroom-frontend",
  "compatibility_date": "2026-11-22",
  "main": "./workers/app.ts",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    // brdrmr.org and www.brdrmr.org are deliberately not attached yet: they
    // carry live email DNS and are attached in a later, staged step
    // (architecture spec §5 and §10).
    { "pattern": "openboardroom.org", "custom_domain": true },
    { "pattern": "www.openboardroom.org", "custom_domain": true },
    { "pattern": "openboardroom.io", "custom_domain": true },
    { "pattern": "www.openboardroom.io", "custom_domain": true },
    { "pattern": "brdrmr.com", "custom_domain": true },
    { "pattern": "www.brdrmr.com", "custom_domain": true }
  ]
}
